### login
< {%
    request.variables.set("basic_auth", "Basic " + btoa("4:password123"));
%}
POST http://localhost:8080/token
Authorization: {{basic_auth}}

> {%
    client.global.set("auth_token", "Bearer " + response.body);
    client.log("token: " + "Bearer " + response.body);
%}

### login
POST http://localhost:8080/loginJWT
content-type: application/json

{
  "userId": 4,
  "password": "password123"
}
> {%
    client.global.set("auth_token", response.headers.valueOf("Authorization"));
    client.log("token: " + response.headers.valueOf("Authorization"));
%}

